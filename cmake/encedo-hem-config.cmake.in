@PACKAGE_INIT@

# Package config for encedo-hem. Consumers do:
#   find_package(encedo-hem CONFIG REQUIRED)
#   target_link_libraries(app PRIVATE encedo-hem::encedo-hem)         # shared
#   target_link_libraries(app PRIVATE encedo-hem::encedo-hem-static)  # static
# Only the variants this build installed are defined (REQ-BUILD-006); the shared
# target brings EHEM_USING_SHARED (dllimport on Windows) to its consumers.
#
# implements: REQ-BUILD-008 — the dependencies of the build's crypto backend are
# resolved here, so a consumer never names libcurl or the crypto library itself.

include(CMakeFindDependencyMacro)
@EHEM_CONFIG_DEPENDENCIES@

include("${CMAKE_CURRENT_LIST_DIR}/encedo-hem-targets.cmake")

check_required_components(encedo-hem)
